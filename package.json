{
  "name": "mareader-marketing-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The marketing site for Mareader, the calm PDF and EPUB reader.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "shots": "node tools/shot.mjs",
    "shots:paged": "node tools/shot.mjs --paged --themes light",
    "assets": "python3 tools/assets_check.py",
    "comments": "python3 tools/comment_check.py src tools",
    "gate": "npm run format:check && npm run lint && npm run check && npm run test && npm run build && npm run assets && npm run comments",
    "ci:watch": "python3 tools/ci.py watch",
    "ci:mode": "python3 tools/ci.py mode"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^16.11.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
