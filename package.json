{
  "name": "mareader-marketing-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "guard": "python3 scripts/guard.py repo",
    "bake": "node scripts/bake-lens.cjs \"$PWD/dist/index.html\" /tmp/bake && python3 scripts/lens-blur.py /tmp/bake src/blur",
    "shots": "node tests/visual/capture.mjs dist .shots all",
    "visual": "node tests/visual/compare.mjs tests/visual/baselines .shots .visual-diff",
    "review": "node scripts/review.mjs",
    "prepare": "python3 scripts/install_hooks.py"
  },
  "dependencies": {
    "lucide": "^1.67.0"
  },
  "overrides": {
    "deepmerge": "file:vendor/deepmerge",
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
